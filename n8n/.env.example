# On the EC2 host this file is generated by Terraform (user_data) at /opt/n8n/.env.
# For local runs, copy to n8n/.env. Gitignored.

# Generate with: openssl rand -hex 32  — encrypts credentials stored by n8n.
# Losing this key makes saved credentials unreadable.
N8N_ENCRYPTION_KEY=

# Public address of the host, used when n8n renders webhook URLs.
N8N_HOST=<ec2-public-ip>
WEBHOOK_URL=http://<ec2-public-ip>:5678/
GENERIC_TIMEZONE=Asia/Kolkata

# n8n v1+ has no basic-auth env vars: the first visitor to the UI creates the owner
# account. Port 5678 is therefore locked to your IP by the security group.
