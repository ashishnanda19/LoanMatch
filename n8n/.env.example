# Copy to n8n/.env on the EC2 host (or locally). Gitignored.

# Generate with: openssl rand -hex 32  — encrypts credentials stored by n8n.
# Losing this key makes saved credentials unreadable.
N8N_ENCRYPTION_KEY=

# Basic auth for the n8n editor UI (plain HTTP only — see README for the HTTPS note).
N8N_BASIC_AUTH_USER=admin
N8N_BASIC_AUTH_PASSWORD=

# Public address the Lambda uses to reach n8n webhooks.
N8N_HOST=<ec2-public-ip>
WEBHOOK_URL=http://<ec2-public-ip>:5678/
GENERIC_TIMEZONE=Asia/Kolkata
