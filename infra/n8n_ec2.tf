# Self-hosted n8n on a single small EC2 instance (docker compose).
# Plain HTTP on :5678, reachable only from your IP and the Lambda (see networking.tf).
# Production would add a reverse proxy with HTTPS and a domain; omitted for scope.

data "aws_ssm_parameter" "al2023" {
  name = "/aws/service/ami-amazon-linux-latest/al2023-ami-kernel-default-x86_64"
}

# Key pair generated by Terraform; the private key is written to a gitignored .pem
# (and also lives in Terraform state, which is gitignored too).
resource "tls_private_key" "n8n" {
  algorithm = "ED25519"
}

resource "aws_key_pair" "n8n" {
  key_name   = "${var.project_name}-n8n"
  public_key = tls_private_key.n8n.public_key_openssh
}

resource "local_sensitive_file" "n8n_pem" {
  content         = tls_private_key.n8n.private_key_openssh
  filename        = "${path.module}/../${var.project_name}-n8n.pem"
  file_permission = "0400"
}

# Encrypts credentials n8n stores. Persisted in state so the same key survives re-applies.
resource "random_id" "n8n_encryption_key" {
  byte_length = 32
}

# Elastic IP so the n8n URL survives stop/start.
resource "aws_eip" "n8n" {
  domain = "vpc"
}

resource "aws_instance" "n8n" {
  ami                    = data.aws_ssm_parameter.al2023.value
  instance_type          = var.n8n_instance_type
  subnet_id              = sort(data.aws_subnets.default.ids)[0]
  vpc_security_group_ids = [aws_security_group.n8n.id]
  key_name               = aws_key_pair.n8n.key_name

  associate_public_ip_address = true

  metadata_options {
    http_tokens = "required" # IMDSv2 only
  }

  root_block_device {
    volume_size = 20
    volume_type = "gp3"
    encrypted   = true
  }

  user_data = templatefile("${path.module}/templates/n8n_user_data.sh.tftpl", {
    compose_b64    = base64encode(file("${path.module}/../n8n/docker-compose.yml"))
    encryption_key = random_id.n8n_encryption_key.hex
    public_ip      = aws_eip.n8n.public_ip
  })

  # user_data only runs on first boot. After that, change n8n via SSH
  # (/opt/n8n) rather than having Terraform bounce the instance.
  lifecycle {
    ignore_changes = [user_data, ami]
  }

  tags = { Name = "${var.project_name}-n8n" }
}

resource "aws_eip_association" "n8n" {
  instance_id   = aws_instance.n8n.id
  allocation_id = aws_eip.n8n.id
}
