# Copy to terraform.tfvars (gitignored) and fill in.
aws_region        = "ap-south-1"
project_name      = "loan-engine"
db_password       = "CHANGE_ME"      # prefer TF_VAR_db_password in your shell
my_ip_cidr        = "203.0.113.4/32" # your IP, for n8n UI + RDS admin access during setup
ec2_key_pair_name = "your-ec2-keypair"
