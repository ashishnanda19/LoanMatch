# Copy to .env and fill in. .env is gitignored — never commit real values.

# --- AWS (used by Terraform / AWS CLI; prefer `aws configure` or SSO over static keys) ---
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=ap-south-1

# --- RDS Postgres (Terraform outputs the host after apply) ---
DB_HOST=
DB_PORT=5432
DB_NAME=loanengine
DB_USER=loanadmin
DB_PASSWORD=
# DATABASE_URL=postgresql://loanadmin:<password>@<host>:5432/loanengine

# --- SES ---
# Must be verified in SES. In sandbox mode every recipient must be verified too.
SES_SENDER_ADDRESS=
# Test inbox aliases that receive ALL notifications. CSV addresses are never emailed.
TEST_RECIPIENT_ONE=yourgmail+one@gmail.com
TEST_RECIPIENT_TWO=yourgmail+two@gmail.com

# --- LLMs (stored as n8n credentials at runtime; listed here for reference) ---
GROQ_API_KEY=
GEMINI_API_KEY=

# --- n8n webhook (parse-csv Lambda calls this after ingestion) ---
N8N_WEBHOOK_URL=http://<ec2-public-ip>:5678/webhook/batch-ready
